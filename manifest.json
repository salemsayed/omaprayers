{
  "schemaVersion": 1,
  "id": "io.github.salemsayed.omaprayers",
  "name": "OmaPrayers",
  "version": "2.2.2",
  "author": "Salem Sayed",
  "license": "MIT",
  "description": "Prayer times in the Omarchy bar: a to-scale day strip or a ruled timetable, Arabic and English, offline cache and notifications.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaPrayers",
    "description": "Next prayer, countdown, Hijri date, monthly cache, and optional notifications",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "locationLabel": "Cairo",
      "locationLabelAr": "",
      "latitude": "30.0444",
      "longitude": "31.2357",
      "timezone": "Africa/Cairo",
      "calculationMethod": 5,
      "hanafi": false,
      "highLatitudeRule": "Angle based",
      "midnightMode": "Standard",
      "shafaq": "General",
      "hijriAdjustment": 0,
      "tune": "0,0,0,0,0,0,0,0,0",
      "customMethodSettings": "",
      "panelStyle": "Horizon",
      "timeFormat": "24-hour",
      "language": "English",
      "arabicFont": "Noto Naskh Arabic",
      "barDisplay": "Strip + countdown",
      "showSunrise": true,
      "showNightMarkers": true,
      "refreshHours": 24,
      "highlightBeforeMinutes": 15,
      "notifications": false,
      "notifyBeforeMinutes": 10,
      "notificationGraceMinutes": 10
    },
    "schema": [
      { "key": "locationLabel", "type": "string", "label": "Location label", "defaultValue": "Cairo" },
      { "key": "locationLabelAr", "type": "string", "label": "Arabic location label", "defaultValue": "", "description": "Shown instead of the location label when prayer names are Arabic." },
      { "key": "latitude", "type": "string", "label": "Latitude", "defaultValue": "30.0444", "description": "Explicit coordinates avoid ambiguous city matching." },
      { "key": "longitude", "type": "string", "label": "Longitude", "defaultValue": "31.2357" },
      { "key": "timezone", "type": "string", "label": "IANA timezone", "defaultValue": "Africa/Cairo", "description": "For example Africa/Cairo or Europe/London. This must match the prayer location." },
      { "key": "calculationMethod", "type": "integer", "label": "AlAdhan method ID", "min": 0, "max": 99, "step": 1, "defaultValue": 5, "description": "5 is the Egyptian General Authority of Survey. Use 99 with custom method settings." },
      { "key": "hanafi", "type": "boolean", "label": "Hanafi Asr", "defaultValue": false },
      { "key": "highLatitudeRule", "type": "enum", "label": "High-latitude rule", "options": ["Middle of the night", "One seventh", "Angle based"], "defaultValue": "Angle based" },
      { "key": "midnightMode", "type": "enum", "label": "Midnight calculation", "options": ["Standard", "Jafari"], "defaultValue": "Standard" },
      { "key": "shafaq", "type": "enum", "label": "Shafaq", "options": ["General", "Red", "White"], "defaultValue": "General", "description": "Used by the Moonsighting Committee method." },
      { "key": "hijriAdjustment", "type": "integer", "label": "Hijri date adjustment", "min": -2, "max": 2, "step": 1, "defaultValue": 0 },
      { "key": "tune", "type": "string", "label": "Per-time tuning", "defaultValue": "0,0,0,0,0,0,0,0,0", "description": "Nine minute offsets: Imsak,Fajr,Sunrise,Dhuhr,Asr,Maghrib,Sunset,Isha,Midnight." },
      { "key": "customMethodSettings", "type": "string", "label": "Custom method settings", "defaultValue": "", "description": "For method 99: FajrAngle,MaghribAngleOrMinutes,IshaAngleOrMinutes." },
      { "key": "panelStyle", "type": "enum", "label": "Panel layout", "options": ["Horizon", "Compact"], "defaultValue": "Horizon", "description": "Horizon draws the day to scale with window lengths. Compact is the ruled timetable card." },
      { "key": "timeFormat", "type": "enum", "label": "Time format", "options": ["24-hour", "12-hour"], "defaultValue": "24-hour" },
      { "key": "language", "type": "enum", "label": "Prayer names", "options": ["English", "Arabic"], "defaultValue": "English" },
      { "key": "arabicFont", "type": "string", "label": "Arabic font family", "defaultValue": "Noto Naskh Arabic", "description": "Font used for Arabic prayer names. The bar's monospace font has no Arabic glyphs." },
      { "key": "barDisplay", "type": "enum", "label": "Bar display", "options": ["Strip + countdown", "Icon only", "Name + countdown", "Name + time", "Countdown only"], "defaultValue": "Strip + countdown" },
      { "key": "showSunrise", "type": "boolean", "label": "Show sunrise", "defaultValue": true },
      { "key": "showNightMarkers", "type": "boolean", "label": "Show midnight and thirds", "defaultValue": true },
      { "key": "refreshHours", "type": "integer", "label": "Online refresh interval (hours)", "min": 1, "max": 168, "step": 1, "defaultValue": 24 },
      { "key": "highlightBeforeMinutes", "type": "integer", "label": "Accent before prayer (minutes)", "min": 0, "max": 120, "step": 5, "defaultValue": 15 },
      { "key": "notifications", "type": "boolean", "label": "Prayer notifications", "defaultValue": false },
      { "key": "notifyBeforeMinutes", "type": "integer", "label": "Notify before prayer (minutes)", "min": 0, "max": 120, "step": 5, "defaultValue": 10 },
      { "key": "notificationGraceMinutes", "type": "integer", "label": "Resume notification grace (minutes)", "min": 1, "max": 60, "step": 1, "defaultValue": 10 }
    ]
  }
}
